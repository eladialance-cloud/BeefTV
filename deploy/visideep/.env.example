# Public deployment settings
VISIDEEP_DOMAIN=manju.example.com
VISIDEEP_WEB_PORT=3100
VISIDEEP_ADMIN_PORT=3101
VISIDEEP_IMAGE_TAG=production
GOPROXY=https://goproxy.cn,direct
APK_MIRROR=https://mirrors.aliyun.com/alpine

# PostgreSQL. Use a long random hex password so DATABASE_URL needs no escaping.
CANVAS_POSTGRES_DB=visideep
CANVAS_POSTGRES_USER=visideep
CANVAS_POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
CANVAS_DATABASE_DRIVER=postgres
DATABASE_URL=postgres://visideep:CHANGE_ME_RANDOM_HEX@postgres:5432/visideep?sslmode=disable
CANVAS_AUTO_MIGRATE=true

# Runtime
CANVAS_BACKEND_ADDR=:8080
CANVAS_BACKEND_DATA_DIR=/data
BEEFTV_AGENT_OPS_URL=http://127.0.0.1:8080/api
CANVAS_SHUTDOWN_TIMEOUT=10m
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
GIN_MODE=release

# Public origin
CANVAS_CORS_ORIGINS=https://manju.example.com
CANVAS_PUBLIC_BASE_URL=https://manju.example.com

# Register this exact username immediately after startup to claim the first admin.
CANVAS_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_UNIQUE_ADMIN_USERNAME
